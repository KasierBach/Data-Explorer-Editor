# Backend Settings
PORT=3001
TRUST_PROXY=0

# App database connection
# Local non-Docker example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/data_explorer
# Docker Compose example:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/data_explorer
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
REFRESH_TOKEN_SECRET=
ENCRYPTION_KEY=replace-with-exactly-32-random-characters
LEGACY_ENCRYPTION_KEYS=
ALLOW_INTERNAL_IPS=false

# AI
GEMINI_API_KEY=your-gemini-key
AI_PROVIDER_TIMEOUT_MS=90000
AI_STREAM_IDLE_TIMEOUT_MS=90000
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_CHAT_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
BEEKNOEE_API_KEY=
BEEKNOEE_BASE_URL=https://platform.beeknoee.com/api/v1
BEEKNOEE_CHAT_MODEL=glm-4.7-flash

# Frontend URL for CORS and OAuth redirects
# Vite local dev:
FRONTEND_URL=http://localhost:5173
# Docker-served frontend example:
# FRONTEND_URL=http://localhost
API_PUBLIC_URL=http://localhost:3001/api

# Auth Providers
GOOGLE_CLIENT_ID=your-google-id
GOOGLE_CLIENT_SECRET=your-google-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

GITHUB_CLIENT_ID=your-github-id
GITHUB_CLIENT_SECRET=your-github-secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Email Settings
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# Billing providers (use sandbox credentials locally)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create

# Emergency compatibility override for self-signed or plaintext remote databases.
# Keep disabled in production; localhost connections are exempt automatically.
ALLOW_INSECURE_DATABASE_TLS=false

# Data minimization. Set a retention value to 0 to disable that cleanup.
AUDIT_RETENTION_DAYS=365
PAYMENT_PAYLOAD_RETENTION_DAYS=30
RETENTION_CLEANUP_INTERVAL_HOURS=24
